+        mesh_tokens = self.mesh_token_embed.weight.unsqueeze(1).repeat(
+            (1, batch_size, 1)
+        )
+        raw_img_features = dino_out[-1]
+        _, _, h, w = raw_img_features.shape
+        img_features_pose = self.conv_1x1(raw_img_features).flatten(2).permute(2, 0, 1) # transformer_dim, b , hxw
+
+        pos_enc = (
+            self.position_encoding(
+                batch_size,
+                h,
+                w,
+                device,
+            )
+            .flatten(2)
+            .permute(2, 0, 1)
+        )
+
+        _, mesh_features = self.transformer(img_features_pose, mesh_tokens, pos_enc)   # transformer_dim, b, hxw
+
+        if self.autoreg:
+            mesh_logits = mesh_features.transpose(0, 1)  # h,w,transformer_dim
+        else:
+            mesh_features = mesh_features.transpose(0, 1)  # b,h*w,transformer_dim
+
+            pred_rot_features = pred_rot.unsqueeze(1).repeat(1, 54, 1).to(mesh_features) # b, 54, 6
+            pred_cam_features = pred_cam.unsqueeze(1).repeat(1, 54, 1).to(mesh_features) # b, 54, 3
+            concat_features = torch.cat(
+                [mesh_features, pred_rot_features, pred_cam_features], dim=-1
+            )  # b, transformer_dim, hxw + 2
+
+            mesh_logits = self.indices_regressor(
