+import os
+import cv2
+import numpy as np
+from tqdm import tqdm
+
+def extract_frames_from_video(video_path, output_dir):
+    """
+    Extract frames from video file and save as JPG images
+    """
+    # Create output directory
+    os.makedirs(output_dir, exist_ok=True)
+    
+    # Open video file
+    cap = cv2.VideoCapture(video_path)
+    
+    if not cap.isOpened():
+        print(f"Error: Could not open video {video_path}")
+        return False
+    
+    frame_count = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
+    print(f"  Extracting {frame_count} frames from {os.path.basename(video_path)}")
+    
+    frame_idx = 0
+    success = True
+    
+    with tqdm(total=frame_count, desc=f"  {os.path.basename(video_path)}") as pbar:
+        while success:
+            success, frame = cap.read()
+            
+            if success:
+                # Save frame as JPG with 6-digit zero-padded filename
+                frame_filename = f"{frame_idx:06d}.jpg"
+                frame_path = os.path.join(output_dir, frame_filename)
+                cv2.imwrite(frame_path, frame)
+                frame_idx += 1
+                pbar.update(1)
+    
+    cap.release()
+    return True
+
+def process_mpi_inf_3dhp():
+    """
+    Process MPI-INF-3DHP dataset by extracting frames from videos
+    and organizing them in the expected directory structure
+    """
+    # Define source and destination directories
+    source_dir = 'datasets/mpi_inf_3dhp'
+    dest_dir = 'datasets/mpi_inf_3dhp_train'
+    
+    # Create the destination directory if it doesn't exist
+    os.makedirs(dest_dir, exist_ok=True)
+    
+    # Iterate over all subjects
+    for subject in ['S1', 'S2', 'S3', 'S4', 'S5', 'S6', 'S7', 'S8']:
+        subject_source = os.path.join(source_dir, subject)
+        subject_dest = os.path.join(dest_dir, subject)
+        
+        if os.path.exists(subject_source):
+            print(f"Processing {subject}")
+            
+            # Create subject directory in destination
+            os.makedirs(subject_dest, exist_ok=True)
+            
+            # Iterate over sequences
+            for seq in ['Seq1', 'Seq2']:
+                seq_source = os.path.join(subject_source, seq)
+                seq_dest = os.path.join(subject_dest, seq)
+                
+                if os.path.exists(seq_source):
+                    # Create sequence directory in destination
+                    os.makedirs(seq_dest, exist_ok=True)
+                    
+                    # Look for imageSequence directory
+                    image_seq_dir = os.path.join(seq_source, 'imageSequence')
+                    
+                    if os.path.exists(image_seq_dir):
+                        # Find all video files
+                        video_files = [f for f in os.listdir(image_seq_dir) if f.endswith('.avi')]
+                        video_files.sort()  # Sort to ensure consistent ordering
+                        
+                        for video_file in video_files:
+                            video_path = os.path.join(image_seq_dir, video_file)
+                            
+                            # Extract video number (e.g., 'video_0.avi' -> '0')
+                            video_name = os.path.splitext(video_file)[0]  # Remove .avi
+                            
+                            # Create video directory in destination (e.g., 'video_0')
+                            video_dest = os.path.join(seq_dest, video_name)
+                            
+                            print(f"  Processing {video_file}")
+                            
+                            # Extract frames from video
+                            if extract_frames_from_video(video_path, video_dest):
+                                print(f"    ✓ Frames extracted to {video_dest}")
+                            else:
+                                print(f"    ✗ Failed to extract frames from {video_file}")
+                    
+                    else:
+                        print(f"  imageSequence directory not found in {seq_source}")
+                else:
+                    print(f"  {seq} does not exist in {subject}")
+        else:
+            print(f"{subject} does not exist in source directory")
+    
+    print("Frame extraction completed!")
+
+if __name__ == "__main__":
+    process_mpi_inf_3dhp()
