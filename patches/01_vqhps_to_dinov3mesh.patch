+import os
+import cv2
+import numpy as np
+from tqdm import tqdm
+
+def extract_specific_frames(video_path, output_dir, frame_indices):
+    """
+    Extract specific frames from video file based on frame indices
+    """
+    try:
+        # Create output directory
+        os.makedirs(output_dir, exist_ok=True)
+        
+        # Open video file
+        cap = cv2.VideoCapture(video_path)
+        
+        if not cap.isOpened():
+            print(f"Error: Could not open video {video_path}")
+            return False
+        
+        frame_count = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
+        print(f"  Extracting {len(frame_indices)} frames from {os.path.basename(video_path)} (total: {frame_count})")
+        
+        # Sort frame indices for efficient extraction
+        sorted_indices = sorted(frame_indices)
+        
+        current_frame = 0
+        extracted_count = 0
+        
+        with tqdm(total=len(frame_indices), desc=f"  {os.path.basename(video_path)}") as pbar:
+            for target_frame in sorted_indices:
+                try:
+                    # Skip frames until we reach the target
+                    while current_frame < target_frame:
+                        ret = cap.read()
+                        if not ret[0]:
+                            break
+                        current_frame += 1
+                    
+                    # Read the target frame
+                    ret, frame = cap.read()
+                    if ret and frame is not None:
+                        # Save frame with 6-digit zero-padded filename (1-indexed)
+                        frame_filename = f"{target_frame+1:06d}.jpg"
+                        frame_path = os.path.join(output_dir, frame_filename)
+                        
+                        # Try to write the frame
+                        success = cv2.imwrite(frame_path, frame)
+                        if success:
+                            extracted_count += 1
+                            current_frame += 1
+                        else:
+                            print(f"    Warning: Could not write frame {target_frame} to {frame_path}")
+                    else:
+                        print(f"    Warning: Could not read frame {target_frame}")
+                        
+                    pbar.update(1)
+                    
+                except Exception as e:
+                    print(f"    Error processing frame {target_frame}: {str(e)}")
+                    pbar.update(1)
+                    continue
+        
+        cap.release()
+        print(f"    ✓ Extracted {extracted_count}/{len(frame_indices)} frames to {output_dir}")
+        return extracted_count > 0
+        
+    except Exception as e:
+        print(f"    ✗ Error processing video {video_path}: {str(e)}")
+        return False
+
+def process_mpi_inf_3dhp_selective():
+    """
+    Process MPI-INF-3DHP dataset by extracting only the frames specified in the annotation file
+    """
+    # Load annotation file to get required frame names
+    annotation_file = 'datasets/mpi_inf_3dhp/mpi_inf_3dhp_train.npz'
+    
+    if not os.path.exists(annotation_file):
+        print(f"Error: Annotation file not found: {annotation_file}")
+        return
+    
+    data = np.load(annotation_file)
+    imgnames = data['imgname']
+    
+    print(f"Found {len(imgnames)} annotated frames")
+    
+    # Group frame names by video
+    video_frames = {}
+    for imgname in imgnames:
+        # Parse path: S1/Seq1/video_0/000001.jpg
+        parts = imgname.split('/')
+        if len(parts) == 4:
+            subject, sequence, video, frame_file = parts
+            video_key = f"{subject}/{sequence}/{video}"
+            
+            # Extract frame number (1-indexed in filename, convert to 0-indexed for video)
+            frame_num = int(frame_file.split('.')[0]) - 1
+            
+            if video_key not in video_frames:
+                video_frames[video_key] = []
+            video_frames[video_key].append(frame_num)
+    
+    print(f"Processing {len(video_frames)} unique videos")
+    
+    # Define source and destination directories
+    source_dir = 'datasets/mpi_inf_3dhp'
+    dest_dir = 'datasets/mpi_inf_3dhp_train'
+    
+    # Create the destination directory if it doesn't exist
+    os.makedirs(dest_dir, exist_ok=True)
+    
+    # Process each video with progress tracking
+    total_videos = len(video_frames)
+    processed_videos = 0
+    successful_videos = 0
+    failed_videos = []
+    
+    for video_key, frame_indices in video_frames.items():
+        parts = video_key.split('/')
+        subject, sequence, video = parts
+        
+        # Construct source video path
+        video_file = f"{video}.avi"
+        video_source_path = os.path.join(source_dir, subject, sequence, 'imageSequence', video_file)
+        
+        # Construct destination directory
+        video_dest_dir = os.path.join(dest_dir, subject, sequence, video)
+        
+        processed_videos += 1
+        progress_pct = int((processed_videos / total_videos) * 100)
+        
+        if os.path.exists(video_source_path):
+            # Check if this video has already been processed
+            expected_frames = set(f"{idx+1:06d}.jpg" for idx in frame_indices)
+            existing_frames = set()
+            
+            if os.path.exists(video_dest_dir):
+                existing_frames = set(f for f in os.listdir(video_dest_dir) if f.endswith('.jpg'))
+            
+            missing_frames = expected_frames - existing_frames
+            
+            if not missing_frames:
+                print(f"[{processed_videos}/{total_videos} - {progress_pct}%] ✓ Skipping {video_key} - already completed ({len(frame_indices)} frames)")
+                successful_videos += 1
+            else:
+                print(f"[{processed_videos}/{total_videos} - {progress_pct}%] Processing {video_key} ({len(missing_frames)}/{len(frame_indices)} frames remaining)")
+                try:
+                    # Extract only missing frames
+                    missing_frame_indices = [int(f.split('.')[0]) - 1 for f in missing_frames]
+                    success = extract_specific_frames(video_source_path, video_dest_dir, missing_frame_indices)
+                    if success:
+                        successful_videos += 1
+                    else:
+                        failed_videos.append(video_key)
+                        print(f"    Failed to extract frames from {video_key}")
+                except Exception as e:
+                    failed_videos.append(video_key)
+                    print(f"    Exception while processing {video_key}: {str(e)}")
+        else:
+            failed_videos.append(video_key)
+            print(f"[{processed_videos}/{total_videos} - {progress_pct}%] Warning: Video not found: {video_source_path}")
+    
+    print(f"\nSelective frame extraction completed!")
+    print(f"Successfully processed: {successful_videos}/{total_videos} videos")
+    if failed_videos:
+        print(f"Failed videos ({len(failed_videos)}):")
+        for failed_video in failed_videos:
+            print(f"  - {failed_video}")
+    else:
+        print("All videos processed successfully!")
+
+if __name__ == "__main__":
+    process_mpi_inf_3dhp_selective()
