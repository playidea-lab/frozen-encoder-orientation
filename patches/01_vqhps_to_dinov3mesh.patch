@@ -0,0 +1,86 @@
+"""
+Script to fix image paths in .npz files
+Changes /media/playidealab/Data/6000ada_backup to /mnt/disk1/Data/6000ada_backup
+"""
+
+import numpy as np
+import os
+from pathlib import Path
+
+OLD_PATH = "/media/playidealab/Data/6000ada_backup"
+NEW_PATH = "/mnt/disk1/Data/6000ada_backup"
+
+def fix_npz_paths(npz_file):
+    """Fix image paths in a .npz file"""
+    print(f"\nProcessing: {npz_file}")
+
+    # Load the data
+    data = np.load(npz_file, allow_pickle=True)
+
+    # Check if imgname field exists
+    if 'imgname' not in data:
+        print(f"  No 'imgname' field found, skipping...")
+        return
+
+    # Get all fields
+    data_dict = {key: data[key] for key in data.keys()}
+
+    # Fix image paths
+    imgnames = data_dict['imgname']
+    fixed_count = 0
+
+    if isinstance(imgnames, np.ndarray):
+        new_imgnames = []
+        for imgname in imgnames:
+            if isinstance(imgname, (str, np.str_)):
+                imgname_str = str(imgname)
+                if imgname_str.startswith(OLD_PATH):
+                    new_imgname = imgname_str.replace(OLD_PATH, NEW_PATH, 1)
+                    new_imgnames.append(new_imgname)
+                    fixed_count += 1
+                else:
+                    new_imgnames.append(imgname_str)
+            else:
+                new_imgnames.append(imgname)
+
+        data_dict['imgname'] = np.array(new_imgnames)
+
+    print(f"  Total images: {len(imgnames)}")
+    print(f"  Paths fixed: {fixed_count}")
+
+    if fixed_count > 0:
+        # Create backup
+        backup_file = npz_file + ".backup"
+        if not os.path.exists(backup_file):
+            print(f"  Creating backup: {backup_file}")
+            os.rename(npz_file, backup_file)
+        else:
+            print(f"  Backup already exists, removing original...")
+            os.remove(npz_file)
+
+        # Save fixed data
+        print(f"  Saving fixed file...")
+        np.savez(npz_file, **data_dict)
+        print(f"  ✓ Successfully fixed and saved!")
+    else:
+        print(f"  No paths needed fixing.")
+
+def main():
+    # Find all .npz files in datasets directory
+    datasets_dir = Path("datasets")
+    npz_files = list(datasets_dir.rglob("*.npz"))
+
+    print(f"Found {len(npz_files)} .npz file(s)")
+    print("=" * 60)
+
+    for npz_file in npz_files:
+        try:
+            fix_npz_paths(str(npz_file))
+        except Exception as e:
+            print(f"  ✗ Error processing {npz_file}: {e}")
+
+    print("\n" + "=" * 60)
+    print("Done!")
+
+if __name__ == "__main__":
+    main()
diff --git a/j_regressor_maker.py b/j_regressor_maker.py
new file mode 100755
index 0000000..f5aebab
--- /dev/null
+++ b/j_regressor_maker.py
@@ -0,0 +1,52 @@
+import numpy as np
+
+in_path = "body_models/smplh/female/model.npz"   # 또는 .pkl
+out_path = "body_models/J_regressor_24.npy"
+
+def load_model(path):
+    if path.endswith(".npz"):
+        return np.load(path, allow_pickle=True)
+    elif path.endswith(".pkl"):
+        import pickle
+        with open(path, "rb") as f:
+            return pickle.load(f, encoding="latin1")
+    else:
+        raise ValueError("Only .npz or .pkl are supported")
+
+data = load_model(in_path)
+
+# 2) 키 탐색: 배포본마다 키 이름이 조금씩 다름
+keys = list(getattr(data, "files", getattr(data, "keys", lambda: [])()) or [])
+if "J_regressor" in keys:
+    J = data["J_regressor"]
+elif "J_regressor_body25" in keys:   # 희귀 케이스 대비
+    J = data["J_regressor_body25"]
+else:
+    # pkl일 때 dict 구조로 들어있으면 이렇게 접근
+    J = data.get("J_regressor", None)
+    if J is None:
+        raise KeyError(f"'J_regressor' not found. Keys: {keys}")
+
+# 3) 희소행렬이면 밀집으로 변환
+toarray = getattr(J, "toarray", None)
+if callable(toarray):
+    J = J.toarray()
+
+J = np.asarray(J)
+n_joints = J.shape[0]
+print("loaded J_regressor shape:", J.shape)
+
+# 4) 행 수에 따라 처리
+if n_joints == 24:
+    J24 = J
+elif n_joints > 24:
+    # 보편적으로 앞 24개가 '몸 24조인트'
+    # (SMPL-H는 54행 -> 앞 24행이 몸, 나머지는 손가락)
+    # (SMPL-X는 얼굴/손 포함 -> 일반적으로 앞 24행이 몸)
+    J24 = J[:24]
+else:
+    raise ValueError(f"Unexpected J_regressor with {n_joints} joints (<24).")
+
+J24 = J24.astype(np.float32)
+np.save(out_path, J24)
+print("saved:", out_path, "shape:", J24.shape)
